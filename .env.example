# 비밀값 파일 – 이 파일을 .env 로 복사해 채우세요. 절대 공유/업로드하지 마세요.

# UVIS 웹 로그인 (source.type: uvis_web)
UVIS_ID=
UVIS_PW=

# 에스원 API 를 받은 경우 (source.type: http_api)
UVIS_API_TOKEN=

# 카카오톡 나에게 보내기 (docs/03_메신저_설정.md)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 텔레그램 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 슬랙/디스코드/팀즈 웹훅
WEBHOOK_URL=
